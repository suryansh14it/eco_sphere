# MongoDB Configuration
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/your_database?retryWrites=true&w=majority

# Session secret - used to sign the httpOnly `user_session` cookie.
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# AUTH_SECRET is accepted as a fallback if JWT_SECRET is not set.
JWT_SECRET=your-super-secret-jwt-key
AUTH_SECRET=

# Next.js Configuration
NEXTAUTH_SECRET=your-nextauth-secret-key
NEXTAUTH_URL=http://localhost:3000

# OpenAI Configuration (optional - issue reports still save without it;
# automatic triage just falls back to community verification)
OPENAI_API_KEY=your-openai-api-key

# Environment
NODE_ENV=development

# OpenCage API Configuration
OPENCAGE_API_KEY=your-opencage-api-key
NEXT_PUBLIC_OPENCAGE_API_KEY=your-opencage-api-key
